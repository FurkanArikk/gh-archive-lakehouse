{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline numbers",
      "queryLines": [
        "SELECT\n",
        "  (SELECT sum(events) FROM daily_bot_share)                                  AS events,\n",
        "  (SELECT round(100 * sum(bot_events) / sum(events), 1) FROM daily_bot_share) AS bot_share_pct,\n",
        "  (SELECT sum(stars) FROM repo_star_growth)                                   AS stars,\n",
        "  (SELECT count(*) FROM pr_time_to_merge)                                     AS prs_merged,\n",
        "  (SELECT count(*) FROM issue_time_to_close)                                  AS issues_closed"
      ]
    },
    {
      "name": "hourly",
      "displayName": "Events per hour",
      "queryLines": [
        "SELECT hour, event_type, events, bot_events\n",
        "FROM hourly_event_volume"
      ]
    },
    {
      "name": "bot_share",
      "displayName": "Bot share by event type",
      "queryLines": [
        "SELECT event_type, round(100 * sum(bot_events) / sum(events), 1) AS bot_share_pct\n",
        "FROM daily_bot_share\n",
        "GROUP BY event_type"
      ]
    },
    {
      "name": "top_active",
      "displayName": "Most active repositories",
      "queryLines": [
        "SELECT repo_name, sum(events) AS events, sum(pushes) AS pushes,\n",
        "       sum(prs_opened) AS prs_opened, sum(issues_opened) AS issues_opened\n",
        "FROM repo_daily_activity\n",
        "GROUP BY repo_name\n",
        "ORDER BY events DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "top_starred",
      "displayName": "Most starred repositories",
      "queryLines": [
        "SELECT repo_name, sum(stars) AS stars\n",
        "FROM repo_star_growth\n",
        "GROUP BY repo_name\n",
        "ORDER BY stars DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "pr_kpis",
      "displayName": "PR merge timing",
      "queryLines": [
        "SELECT count(*)                                              AS merged,\n",
        "       count(hours_to_merge)                                 AS timed,\n",
        "       round(100 * count(hours_to_merge) / count(*), 1)      AS coverage_pct,\n",
        "       round(percentile(hours_to_merge, 0.5) * 60, 1)        AS median_minutes,\n",
        "       round(percentile(hours_to_merge, 0.9), 2)             AS p90_hours\n",
        "FROM pr_time_to_merge"
      ]
    },
    {
      "name": "pr_by_author",
      "displayName": "Timed merges by who opened the PR",
      "queryLines": [
        "SELECT CASE WHEN opened_by_bot THEN 'bot' ELSE 'human' END AS opened_by,\n",
        "       count(*) AS timed_merges,\n",
        "       round(percentile(hours_to_merge, 0.5) * 60, 1) AS median_minutes\n",
        "FROM pr_time_to_merge\n",
        "WHERE hours_to_merge IS NOT NULL\n",
        "GROUP BY 1"
      ]
    },
    {
      "name": "issue_kpis",
      "displayName": "Issue close timing",
      "queryLines": [
        "SELECT count(*)                                AS closes,\n",
        "       round(percentile(days_to_close, 0.5), 1) AS median_days,\n",
        "       count_if(closed_at_from_event)           AS closed_at_fallbacks\n",
        "FROM issue_time_to_close"
      ]
    },
    {
      "name": "issue_by_reason",
      "displayName": "Issue closes by reason and author",
      "queryLines": [
        "SELECT coalesce(state_reason, 'unknown')                             AS state_reason,\n",
        "       CASE WHEN author_is_bot THEN 'bot author' ELSE 'human author' END AS author,\n",
        "       count(*)                                                      AS closes,\n",
        "       round(percentile(days_to_close, 0.5), 1)                      AS median_days\n",
        "FROM issue_time_to_close\n",
        "GROUP BY 1, 2"
      ]
    },
    {
      "name": "dq_latest",
      "displayName": "Latest result of every check",
      "queryLines": [
        "SELECT layer, `check`, target, observed, expected, checked_at,\n",
        "       CASE WHEN passed THEN 'pass' WHEN severity = 'warn' THEN 'warn' ELSE 'fail' END AS status\n",
        "FROM dq_results\n",
        "QUALIFY row_number() OVER (PARTITION BY layer, `check`, target ORDER BY checked_at DESC) = 1"
      ]
    },
    {
      "name": "dq_summary",
      "displayName": "Check status counts",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT passed, severity\n",
        "  FROM dq_results\n",
        "  QUALIFY row_number() OVER (PARTITION BY layer, `check`, target ORDER BY checked_at DESC) = 1\n",
        ")\n",
        "SELECT count_if(passed)                              AS passing,\n",
        "       count_if(NOT passed AND severity = 'warn')    AS warnings,\n",
        "       count_if(NOT passed AND severity = 'error')   AS failing\n",
        "FROM latest"
      ]
    }
  ],
